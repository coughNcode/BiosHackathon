# ─────────────────────────────────────────────────────────────────────────────
# PayGuard AI Collector & Evaluation Environment (Laptop C / Port 4050)
# Real-Time Telemetry Correlation, Audit Persistence, and Security Scorecard
# ─────────────────────────────────────────────────────────────────────────────

# Network binding
HOST=0.0.0.0
COLLECTOR_PORT=4050

# SQLite database file path
DB_FILE=./data/payguard-collector.db

# Backend service endpoints for cross-service evaluation
BLUE_URL=http://localhost:4010
RED_URL=http://localhost:4060
MOCK_CHAIN_URL=http://localhost:4040

# For multi-laptop deployment:
# BLUE_URL=http://<LAPTOP_A_IP>:4010
# RED_URL=http://<LAPTOP_B_IP>:4060
# MOCK_CHAIN_URL=http://<LAPTOP_A_IP>:4040

# Admin authorization key for resetting evaluation runs
ADMIN_KEY=dev-admin-key

# Allowed CORS origins
CORS_ORIGINS=https://*.lovable.app,http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
