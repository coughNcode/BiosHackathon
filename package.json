{
  "name": "@nirholas/x402-agent-wallet",
  "version": "0.1.0",
  "description": "Wallet policy daemon for agents — budgets, per-merchant caps, approval thresholds, signed policy verdicts",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/x402-agent-wallet"
  },
  "homepage": "https://nirholas.github.io/x402-agent-wallet/",
  "keywords": [
    "x402",
    "micropayments",
    "usdc",
    "solana",
    "base",
    "ai-agents",
    "agentic-commerce",
    "wallet",
    "spending-caps",
    "budgets",
    "policy",
    "guardrails"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skill.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/server.ts",
    "blue": "tsx src/blue-agent.ts",
    "chain": "tsx src/mock-chain.ts",
    "test": "vitest run",
    "build": "tsc",
    "start": "node dist/server.js",
    "client": "tsx examples/agent-client.ts",
    "red:merchant": "tsx src/red/merchant.ts",
    "red:facilitator": "tsx src/red/facilitator.ts",
    "red:console": "tsx src/red/console.ts",
    "test": "tsx --test tests/*.test.ts",
    "red": "tsx src/red/start.ts",
    "red:cli": "tsx src/red/cli.ts"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@three-ws/x402-payment-modal": "^1.2.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "uuid": "^14.0.3",
    "viem": "^2.21.0",
    "x402": "^1.2.0",
    "x402-fetch": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "nirholas <nichxbt@gmail.com>"
}
